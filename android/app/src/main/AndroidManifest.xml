<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync progress and the player's notification (asked at first launch on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="dev.irwingbraga.groovelight.app.GroovelightApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Groovelight"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <!-- The same component name as Groovelight Sync's, so launcher icons survive the update. -->
        <activity
            android:name="dev.irwingbraga.groovelight.sync.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play ... on Groovelight" by voice (Google Assistant, Android Auto). -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Holding the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- The player (declared in the playback module): as a media browser for Android Auto, stated here too. -->
        <service
            android:name="dev.irwingbraga.groovelight.playback.PlaybackService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto: Groovelight is a media app there. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />

        <!-- The covers, read-only, for Android Auto's lists (it shows them from its own app). -->
        <provider
            android:name="dev.irwingbraga.groovelight.app.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Home screen widgets: Now Playing, and Recently Played (tap an album to play it). -->
        <receiver
            android:name="dev.irwingbraga.groovelight.widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="Now Playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now_playing" />
        </receiver>
        <receiver
            android:name="dev.irwingbraga.groovelight.widget.RecentlyPlayedWidgetReceiver"
            android:exported="true"
            android:label="Recently Played">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_recently_played" />
        </receiver>

        <!-- The Quick Settings tile: play or pause, with the song playing. -->
        <service
            android:name="dev.irwingbraga.groovelight.app.PlayerTile"
            android:exported="true"
            android:icon="@drawable/ic_play"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Covers shared with other apps (Share on songs and albums), read-only and only the ones shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_covers" />
        </provider>
    </application>
</manifest>
