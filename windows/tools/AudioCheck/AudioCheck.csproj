<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the Windows output without a window: lists the device and what it takes, and plays songs silently
       (volume 0) through the real WASAPI path to see time move and songs follow each other. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Groovelight.Audio.Windows\Groovelight.Audio.Windows.csproj" />
  </ItemGroup>
</Project>
