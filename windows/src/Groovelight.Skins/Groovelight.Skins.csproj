<Project Sdk="Microsoft.NET.Sdk">
  <!-- The vintage players of Now Playing (the Mac's Skins package): the turntable, the cassette deck, the CD player and
       the PC Player, drawn with SkiaSharp, and the cassette designs. Plain .NET: they render offscreen on the Mac too,
       for tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Groovelight.Skins</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.jpg;Resources\*.ttf" LogicalName="%(Filename)%(Extension)" />
    <None Include="Resources\TapeCue.wav" CopyToOutputDirectory="PreserveNewest" Link="Skins\TapeCue.wav" />
    <None Include="Resources\CREDITS.md;Resources\*-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Skins" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Groovelight.Tests" />
  </ItemGroup>
</Project>
